{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kubi:present_firework_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/present_sparks"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 120
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1+1.5*variable.particle_random_1"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "360*variable.particle_random_1",
        "rotation_rate": 10
      },
      "minecraft:particle_initial_speed": "3+1.5*variable.particle_random_3",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -1.5, 0],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.03+variable.particle_random_1/30", "0.03+variable.particle_random_1/30"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": ["math.floor(variable.particle_random_2*8)*8", 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(2*math.floor(v.emitter_random_1*4)+v.particle_random_1)/7",
          "gradient": {
            "0.0": "#FFFF4040",
            "0.14": "#FFFFFFFF",
            "0.29": "#FF40FF40",
            "0.43": "#FFFFFFFF",
            "0.57": "#FF4040FF",
            "0.71": "#FFFFFFFF",
            "0.86": "#FFFF40FF",
            "1.0": "#FFFFFFFF"
          }
        }
      }
    }
  }
}
